# Content pack files are hashed and signed byte for byte: keep them as
# committed on every system (no CRLF conversion on Windows).
internal/detect/packs/** -text

# Files that Linux containers read or run keep Unix line endings (LF), also
# in a checkout on Windows: Docker Desktop mounts them into the containers
# as they are, and sh cannot run a script with Windows line endings (CRLF).
deploy/docker/opensearch/*.sh text eol=lf
deploy/docker/opensearch/*.yml text eol=lf
deploy/docker/opensearch/security/*.yml text eol=lf

# Go reads a fuzz corpus file's first line as its version, which a Windows
# line ending (CRLF) would break.
**/testdata/fuzz/** text eol=lf

# The install script the servers hand out runs on Linux, and its SHA-256 is
# checked by the line pasted there: the same bytes on every system.
deploy/linux/*.sh text eol=lf
